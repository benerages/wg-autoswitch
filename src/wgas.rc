// wgas.rc - Versionsinfo + Meldungstabelle (wgas_msg.rc wird von mc.exe erzeugt).
#include <winver.h>
#include "version.h"
#include "wgas_msg.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     WGAS_VERSION_MAJOR,WGAS_VERSION_MINOR,WGAS_VERSION_PATCH,0
 PRODUCTVERSION  WGAS_VERSION_MAJOR,WGAS_VERSION_MINOR,WGAS_VERSION_PATCH,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  "WG-AutoSwitch service and command line"
      VALUE "FileVersion",      WGAS_VERSION_STR
      VALUE "InternalName",     "wgas"
      VALUE "OriginalFilename", "wgas.exe"
      VALUE "ProductName",      "WG-AutoSwitch"
      VALUE "CompanyName",      "WG-AutoSwitch contributors"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "ProductVersion",   WGAS_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
