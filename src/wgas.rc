// wgas.rc - Versionsinfo + Meldungstabelle (wgas_msg.rc wird von mc.exe erzeugt).
#include <winver.h>
#include "wgas_msg.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,1,0,0
 PRODUCTVERSION  1,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "FileDescription",  "WG-AutoSwitch - WireGuard-Autoschalter"
      VALUE "FileVersion",      "1.1.0"
      VALUE "InternalName",     "wgas"
      VALUE "OriginalFilename", "wgas.exe"
      VALUE "ProductName",      "WG-AutoSwitch"
      VALUE "ProductVersion",   "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0407, 1200
  END
END
